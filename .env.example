# ---- Dawnhalo frontend (root) ----
# Vite only exposes vars prefixed with VITE_ to the client. Never put secrets here.

# Base URL of the Express backend (server/). Empty = same origin (if you proxy /api).
VITE_API_URL=http://localhost:8787

# NOTE: The Anthropic and Stripe SECRET keys live ONLY in server/.env — they must
# never appear in this file or any VITE_ variable, or they would ship to browsers.

# Public origin of the DEPLOYED frontend (e.g. https://dawnhalo.app). Used to
# build absolute og:image URLs so shared links preview correctly in
# WhatsApp/Telegram/iMessage. Leave empty in local dev.
VITE_APP_URL=

# ---- Analytics (optional) ----
# PostHog project API key (public, safe to expose). Leave empty to disable
# analytics entirely — every track() call becomes a no-op.
VITE_POSTHOG_KEY=
# PostHog host; defaults to https://us.i.posthog.com (use eu.i.posthog.com for EU).
VITE_POSTHOG_HOST=
