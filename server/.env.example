# ---- Dawnhalo backend (server/) ----

# Anthropic — powers card generation. Without it, the API serves graceful
# deterministic fallback cards (the app still works). Keep this server-side ONLY.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to the launch model. Do NOT use claude-sonnet-4-20250514.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe — subscriptions. Without these, /api/stripe/* returns 503 and the app
# stays on the free tier.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...   # $9.99/mo recurring price
STRIPE_PRICE_ID_YEARLY=price_...    # $59.99/yr recurring price

# Database — SQLite file path (better-sqlite3). For Postgres, see README notes.
DATABASE_URL=./dawnhalo.db

# Server
PORT=8787
NODE_ENV=development

# CORS: comma-separated list of allowed frontend origins, or "*" for any.
CORS_ORIGINS=http://localhost:3000

# Public URL of the frontend, used for Stripe success/cancel redirects.
APP_BASE_URL=http://localhost:3000
